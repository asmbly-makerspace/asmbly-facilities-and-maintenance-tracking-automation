{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m pytest)",
      "Bash(python -m pytest *)",
      "Bash(pytest)",
      "Bash(pytest *)",
      "Bash(.venv/bin/python -m pytest)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(cfn-lint *)",
      "Bash(.venv/bin/cfn-lint *)",
      "Bash(sam validate *)",
      "Bash(sam build)",
      "Bash(sam build *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git grep *)",
      "Bash(git merge-base *)",
      "Bash(git fetch origin)",
      "Bash(git fetch origin *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/offshore-guardrails.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
